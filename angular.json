{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "jodit-angular-lib": {
      "projectType": "library",
      "root": "projects/jodit-angular-lib",
      "sourceRoot": "projects/jodit-angular-lib/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/jodit-angular-lib/ng-package.json",
            "tsConfig": "projects/jodit-angular-lib/tsconfig.lib.json"
          },
          "configurations": {
            "production": {},
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/jodit-angular-lib/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "jodit-angular-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/jodit-angular-app",
      "sourceRoot": "projects/jodit-angular-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/jodit-angular-app",
            "index": "projects/jodit-angular-app/src/index.html",
            "browser": "projects/jodit-angular-app/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/jodit-angular-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "projects/jodit-angular-app/src",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/jodit-angular-app/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "node_modules/jodit/es2021/jodit.min.css",
              "projects/jodit-angular-app/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "projects/jodit-angular-app/src/environments/environment.ts",
                  "with": "projects/jodit-angular-app/src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "jodit-angular-app:build:production"
            },
            "development": {
              "buildTarget": "jodit-angular-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/jodit-angular-app/tsconfig.spec.json",
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "projects/jodit-angular-app/src",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/jodit-angular-app/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "node_modules/jodit/es2021/jodit.min.css",
              "projects/jodit-angular-app/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
