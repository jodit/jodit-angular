{
  "name": "jodit-angular-workspace",
  "version": "2.0.0",
  "description": "Angular wrapper for the Jodit WYSIWYG editor",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build jodit-angular",
    "build:demo": "ng build demo",
    "watch": "ng build jodit-angular --watch --configuration development",
    "test": "ng test jodit-angular --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test jodit-angular",
    "lint": "ng lint",
    "format": "prettier --write \"projects/**/*.{ts,html,css,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css,md}\" \"*.{json,md}\"",
    "version": "node scripts/sync-version.mjs && git add projects/jodit-angular/package.json CHANGELOG.md",
    "release": "npm version patch && git push --follow-tags origin HEAD"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jodit/jodit-angular.git"
  },
  "keywords": [
    "angular",
    "jodit",
    "html",
    "text",
    "editor",
    "wysiwyg",
    "rich editor",
    "rich text editor",
    "rte"
  ],
  "author": "Chupurnov Valeriy <chupurnov@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jodit/jodit-angular/issues"
  },
  "homepage": "https://github.com/jodit/jodit-angular#readme",
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "jodit": "^4.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.38",
    "@angular/cli": "^20.3.38",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~7.0.0",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2"
  }
}
